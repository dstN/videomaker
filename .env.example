# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash

# ── Claude (story writing; splitting/descriptions/translation stay on Gemini)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
STORY_LLM=claude
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high
STORY_CONTINUITY_PASS=true

# ── App ───────────────────────────────────────────────────────────────────────
API_BASE_URL=http://api:8000
WHISPERX_URL=http://whisperx:8600

# ── Paths (inside container) ──────────────────────────────────────────────────
DATA_DIR=/data
ASSETS_DIR=/assets
OUTPUT_DIR=/output
DATABASE_URL=sqlite:////data/videomaker.db

# ── Voxtral TTS Model ─────────────────────────────────────────────────────────
# Public HuggingFace repo — no token needed. Downloaded automatically on first run.
VOXTRAL_REPO_ID=TrevorJS/voxtral-tts-q4-gguf
VOXTRAL_CACHE_DIR=/data/models/voxtral

# ── Voxtral TTS service (runs on the Windows host, see Start-VoxtralService.ps1)
# The Windows host IP can change after a reboot. From WSL:
#   ip route show default | awk '{print $3}'
VOXTRAL_URL=http://172.29.176.1:8700
TTS_EULER_STEPS=8
TTS_TIMEOUT_S=400
TTS_RETRY_ATTEMPTS=3
TTS_RETRY_BASE_DELAY=10

# ── Video parts. Hard limit 180 s per video (YouTube Shorts).
# Voxtral speaks 2.65-3.2 words/s: 190-460 words ≈ 60-174 s of narration.
MAX_PART_SECONDS=180
PART_MIN_WORDS=190
PART_MAX_WORDS=460
# Max parts per story; longer stories become a series ("<title> – Part 2", ...)
MAX_PARTS=6

# ── Rendering ─────────────────────────────────────────────────────────────────
FFMPEG_PRESET=fast
VIDEO_CODEC=h264_nvenc
AUDIO_CODEC=aac
MUSIC_VOLUME=0.10
