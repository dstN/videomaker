# ── WhisperX microservice ─────────────────────────────────────────────────────
# Separate CUDA container to isolate heavy model loading from main API
FROM nvidia/cuda:12.1.0-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-dev \
    python3-pip \
    python3-venv \
    ffmpeg \
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# python3 on Ubuntu 22.04 is 3.10 — register it as the default python binary
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3 1

WORKDIR /whisperx_service

# Install PyTorch with CUDA 12.1 support first (heavy, separate layer)
RUN pip3 install --no-cache-dir \
    torch==2.3.0+cu121 \
    torchaudio==2.3.0+cu121 \
    --index-url https://download.pytorch.org/whl/cu121

COPY requirements.whisperx.txt .
RUN pip3 install --no-cache-dir -r requirements.whisperx.txt

COPY whisperx_service/ .

# WhisperX model cache dir (mounted as volume in production)
RUN mkdir -p /root/.cache/whisperx

EXPOSE 8600
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8600"]
